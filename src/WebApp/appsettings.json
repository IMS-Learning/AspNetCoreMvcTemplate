{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "TokenExpiryMinutes": 480,
    "Issuer": "WebApp",
    "Audience": "WebApp"
  },
  "Database": {
    "CommandTimeout": 30,
    "MaxPoolSize": 10
  },
  "Smtp": {
    "Port": 587,
    "EnableSsl": true
  },
  "ExternalApi": {
    "TimeoutSeconds": 30
  }
}
