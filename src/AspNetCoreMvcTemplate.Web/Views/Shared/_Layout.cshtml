<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AspNetCoreMvcTemplate</title>
    <link rel="icon" type="image/png" href="~/images/logo-segolily_slc_rgb.png">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/bootstrap-overrides.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/pagination.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/card.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    @await Html.PartialAsync("_Header")
    <div class="container mt-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    @await Html.PartialAsync("_Footer")
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
